{
  "name": "mcp-sshpilot",
  "version": "1.4.0",
  "description": "MCP server for SSH: saved profiles the agent never sees, several servers at once, host-key pinning, SFTP, proxies (SOCKS/HTTP), dangerous-command guard, and an HTTPS remote mode with an encrypted vault.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sshpilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "docs",
    "servers.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "sftp",
    "proxy",
    "socks",
    "cursor",
    "claude",
    "server-management",
    "streamable-http",
    "remote-mcp"
  ],
  "author": "beekamai",
  "homepage": "https://github.com/beekamai/mcp-sshpilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beekamai/mcp-sshpilot.git"
  },
  "bugs": {
    "url": "https://github.com/beekamai/mcp-sshpilot/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "socks": "^2.8.8",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.6.0",
    "typescript": "^6.0.3"
  }
}
